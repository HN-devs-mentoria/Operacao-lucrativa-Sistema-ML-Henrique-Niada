# Você NÃO precisa editar este arquivo.
# O "npm start" cria o .env sozinho na primeira vez, com uma ML_DB_KEY aleatória.
# App ID e chave secreta do Mercado Livre são cadastrados NO PAINEL, na tela de
# Configuração, e ficam no SQLite (a chave secreta vai cifrada). Quem já usa o plugin
# hn-anuncio-ml não cadastra nada: o painel reaproveita o mesmo app.

# Chave que cifra os tokens no banco (32 bytes em hex). Gerada automaticamente.
# Perder esta chave = ter de reconectar as contas do Mercado Livre.
ML_DB_KEY=

# Portas locais. Se estiverem ocupadas, o npm start escolhe a próxima livre.
PORT=3100
SCRAPER_PORTA=8100

ML_SITE=MLB
ML_DB_FILE=dados.sqlite

# ---- Avançado (deixe como está na aula) ----
# Para onde o Mercado Livre devolve o login (tem de estar em "URIs de redirect" no
# DevCenter). Vazio = a do plugin hn-anuncio-ml ou https://httpbin.org/get.
ML_REDIRECT_URI=
# 0 = não abrir o navegador sozinho ao rodar npm start
ABRIR_NAVEGADOR=1
